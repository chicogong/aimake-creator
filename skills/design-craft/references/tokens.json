{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "design-craft-tokens",
  "version": "1.0.0",
  "description": "Design system tokens for Aimake Deep Obsidian and Atelier Vellum palettes",
  "tokens": {
    "color": {
      "dark": {
        "surface": {
          "void": "#050608",
          "base": "#090a0f",
          "surface": "#0e1017",
          "card": "#141721",
          "hover": "#1c202e",
          "active": "#23283a"
        },
        "text": {
          "primary": "#f2f3f5",
          "secondary": "#9ba1b0",
          "muted": "#5e6475",
          "tertiary": "#3e4453"
        },
        "border": {
          "hairline": "rgba(255, 255, 255, 0.08)",
          "subtle": "rgba(255, 255, 255, 0.12)",
          "highlight": "rgba(255, 255, 255, 0.18)",
          "inner_specular": "inset 0 1px 0 rgba(255, 255, 255, 0.06)"
        },
        "accent": {
          "creator_violet": "#6366f1",
          "calm_teal": "#14b8a6",
          "amber_focus": "#f59e0b",
          "crimson_error": "#ef4444"
        }
      },
      "light": {
        "surface": {
          "void": "#e4e2dc",
          "base": "#eceae4",
          "surface": "#f5f4ef",
          "card": "#ffffff",
          "hover": "#f0eee8",
          "active": "#e6e3da"
        },
        "text": {
          "primary": "#121316",
          "secondary": "#575c69",
          "muted": "#8c92a1",
          "tertiary": "#b9bec9"
        },
        "border": {
          "hairline": "rgba(0, 0, 0, 0.08)",
          "subtle": "rgba(0, 0, 0, 0.14)",
          "highlight": "rgba(0, 0, 0, 0.22)",
          "inner_specular": "inset 0 1px 0 rgba(255, 255, 255, 0.60)"
        },
        "accent": {
          "creator_violet": "#4f46e5",
          "calm_teal": "#0d9488",
          "amber_focus": "#d97706",
          "crimson_error": "#dc2626"
        }
      }
    },
    "typography": {
      "font_family": {
        "sans": "\"Geist Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"PingFang SC\", sans-serif",
        "mono": "\"Geist Mono\", SFMono-Regular, Menlo, Monaco, Consolas, monospace"
      },
      "scale": {
        "display_2xl": { "fontSize": "48px", "lineHeight": "1.08", "letterSpacing": "-0.04em", "fontWeight": 700 },
        "title_xl":    { "fontSize": "32px", "lineHeight": "1.15", "letterSpacing": "-0.03em", "fontWeight": 600 },
        "headline_lg": { "fontSize": "24px", "lineHeight": "1.25", "letterSpacing": "-0.02em", "fontWeight": 600 },
        "subhead_md":  { "fontSize": "18px", "lineHeight": "1.35", "letterSpacing": "-0.01em", "fontWeight": 500 },
        "body_base":   { "fontSize": "14px", "lineHeight": "1.55", "letterSpacing": "-0.005em", "fontWeight": 400 },
        "caption_sm":  { "fontSize": "12px", "lineHeight": "1.45", "letterSpacing": "0em", "fontWeight": 400 },
        "mono_code":   { "fontSize": "12px", "lineHeight": "1.40", "letterSpacing": "-0.01em", "fontWeight": 450 }
      }
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px"
    },
    "radius": {
      "xs": "4px",
      "sm": "6px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "pill": "9999px"
    },
    "motion": {
      "timing_fast": "140ms",
      "timing_standard": "200ms",
      "timing_subtle": "300ms",
      "easing_spring": "cubic-bezier(0.16, 1, 0.3, 1)"
    }
  }
}
